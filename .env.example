NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for public shared-board image URLs and maintenance.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Optional email delivery. Without these, invitation endpoints return a manual link.
RESEND_API_KEY=re_example
EMAIL_FROM=Moodboard <invitations@example.com>

# Required by the Vercel cron endpoint.
CRON_SECRET=replace_with_long_random_value
